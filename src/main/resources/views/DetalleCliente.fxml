<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registro.controllers.DetalleClienteController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <ImageView fx:id="imgFoto" fitHeight="150.0" fitWidth="150.0" preserveRatio="true" />
    <Label fx:id="lblNombreCompleto" text="Nombre Apellido">
        <font><Font name="System Bold" size="20.0" /></font>
    </Label>
    <Label fx:id="lblDetalles" text="Detalles del cliente..." wrapText="true" />
</VBox>