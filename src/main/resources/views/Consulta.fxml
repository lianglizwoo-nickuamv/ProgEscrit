<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="500.0" prefWidth="700.0" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.ConsultaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Consulta de Clientes Registrados">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- La tabla donde mostraremos los datos -->
    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombres" prefWidth="120.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="120.0" text="Apellidos" />
            <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo Cliente" />
            <TableColumn fx:id="colCiudad" prefWidth="100.0" text="Ciudad" />
            <TableColumn fx:id="colFecha" prefWidth="100.0" text="Nacimiento" />
            <TableColumn fx:id="colSolicitud" prefWidth="100.0" text="Solicitud" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <children>
            <!-- Botón para usar el DirectoryChooser -->
            <Button onAction="#exportarReporte" text="Exportar Reporte..." />
            <Button onAction="#cerrar" text="Cerrar" />
        </children>
    </HBox>
</VBox>