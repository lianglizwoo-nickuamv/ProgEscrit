<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0"
            prefWidth="800.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.PrincipalController">

    <top>
        <VBox>

            <MenuBar>
                <menus>

                    <Menu text="Sistema">
                        <items>
                            <MenuItem text="Salir"
                                      onAction="#salir"/>
                        </items>
                    </Menu>

                    <Menu text="Clientes">
                        <items>
                            <MenuItem text="Registrar cliente"
                                      onAction="#abrirRegistro"/>

                            <MenuItem text="Consultar clientes"
                                      onAction="#abrirConsulta"/>
                        </items>
                    </Menu>

                    <Menu text="Ayuda">
                        <items>
                            <MenuItem text="Acerca del sistema"
                                      onAction="#mostrarAcercaDe"/>
                        </items>
                    </Menu>

                </menus>
            </MenuBar>

            <ToolBar>
                <items>

                    <Button text="Registrar cliente"
                            onAction="#abrirRegistro"
                            prefHeight="30.0"/>

                    <Button text="Consultar clientes"
                            onAction="#abrirConsulta"
                            prefHeight="30.0"/>

                </items>
            </ToolBar>

        </VBox>
    </top>

    <center>
        <VBox fx:id="areaCentral"
              alignment="CENTER"
              spacing="24.0"
              pickOnBounds="true">

            <padding>
                <Insets top="30.0"
                        right="40.0"
                        bottom="30.0"
                        left="40.0"/>
            </padding>

            <Label text="Sistema de Registro de Clientes"
                   wrapText="true"
                   textAlignment="CENTER">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>

            <Label text="Seleccioná una opción de la barra superior para comenzar."
                   wrapText="true"
                   textAlignment="CENTER"/>

            <Separator maxWidth="480.0"/>

            <VBox spacing="12.0" maxWidth="480.0">

                <Label text="Registrar cliente">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>

                <Label text="Ingresá los datos personales, la solicitud, los servicios y una fotografía."
                       wrapText="true"/>

                <Label text="Consultar clientes">
                    <font>
                        <Font name="System Bold" size="15.0"/>
                    </font>
                </Label>

                <Label text="Revisá los registros y hacé doble clic sobre un cliente para ver sus detalles."
                       wrapText="true"/>

            </VBox>

            <Separator maxWidth="480.0"/>

            <Label text="Hacé clic derecho en esta área para abrir las opciones."
                   wrapText="true"
                   textAlignment="CENTER"/>

        </VBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">

            <padding>
                <Insets top="12.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <Label text="Sistema de Registro — Versión 1.0"/>

        </VBox>
    </bottom>

</BorderPane>
