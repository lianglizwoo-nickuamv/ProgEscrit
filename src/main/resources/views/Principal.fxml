<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controllers.PrincipalController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label text="Menú Principal">
        <font>
            <Font name="System Bold" size="22.0"/>
        </font>
    </Label>

    <Button text="Registrar Nuevo Cliente" onAction="#abrirRegistro" prefWidth="200.0"/>
    <Button text="Consultar Clientes" onAction="#abrirConsulta" prefWidth="200.0"/>
    <Button text="Acerca de" onAction="#mostrarAcercaDe" prefWidth="200.0"/>
    <Button text="Cerrar Sesión / Salir" onAction="#salir" prefWidth="200.0" textFill="red"/>
</VBox>